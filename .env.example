# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend Production Mode API Endpoint (Spring Boot REST API)
VITE_API_BASE_URL="http://localhost:8080/api"

# Local Spring Boot + MySQL execution variables (never commit real secrets)
MYSQL_DATABASE="billbook_db"
MYSQL_USER="billbook_user"
MYSQL_PASSWORD="changeme_local_only"
MYSQL_ROOT_PASSWORD="changeme_root_local_only"
BILLBOOK_SELLER_STATE="Karnataka"
BILLBOOK_SELLER_GSTIN="29AABCA4821K1Z5"
BILLBOOK_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
